{
  "name": "schwarm",
  "version": "0.1.0",
  "description": "A calm, modern web UI for qBittorrent, served as its alternative WebUI",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "bun run --parallel dev:mock dev:web",
    "dev:web": "vite",
    "dev:mock": "bun --watch dev/mock-server.ts",
    "build": "vite build && bun scripts/check-build.ts",
    "preview": "bun dev/mock-server.ts --static dist/public",
    "package": "bun scripts/package.ts",
    "typecheck": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide && tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide && vitest run",
    "e2e": "bun --bun playwright test",
    "screenshots": "SCREENSHOTS=1 bun --bun playwright test --project=screenshots",
    "release:patch": "npm version patch",
    "release:minor": "npm version minor",
    "release:major": "npm version major",
    "postversion": "git push --follow-tags"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "^3.14.26",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.71.0",
    "radix-ui": "^1.8.1",
    "react": "19",
    "react-dom": "19",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "uplot": "^1.6.32",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@inlang/paraglide-js": "2",
    "@inlang/plugin-message-format": "^4.6.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/router-plugin": "^1.169.0",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
